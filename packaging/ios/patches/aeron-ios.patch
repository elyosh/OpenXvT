+
+/* Returns 1 when insets leave a usable strict subset of the container. */
+static int Aeron_PresentationAvailableBox(int container_width, int container_height, int* origin_x, int* origin_y,
+										  int* avail_width, int* avail_height) {
+	int inset_left;
+	int inset_top;
+	int inset_right;
+	int inset_bottom;
+
+	Aeron_ScaledPresentationInsets(container_width, container_height, &inset_left, &inset_top, &inset_right,
+								   &inset_bottom);
+	*origin_x     = inset_left;
+	*origin_y     = inset_top;
+	*avail_width  = container_width - *origin_x - inset_right;
+	*avail_height = container_height - *origin_y - inset_bottom;
+	if (*avail_width < 1 || *avail_height < 1) {
+		*origin_x     = 0;
+		*origin_y     = 0;
+		*avail_width  = container_width;
+		*avail_height = container_height;
+
+		return 0;
+	}
+
+	return *avail_width != container_width || *avail_height != container_height;
+}
