+int Aeron_GetPresentationAvailablePixelSize(int* width, int* height) {
+	int pixel_w     = 0;
+	int pixel_h     = 0;
+	int origin_x    = 0;
+	int origin_y    = 0;
+	int avail_width = 0;
+	int avail_height = 0;
+	int subset;
+
+	if (width) {
+		*width = 0;
+	}
+	if (height) {
+		*height = 0;
+	}
+	if (!g_aeron.window || !SDL_GetWindowSizeInPixels(g_aeron.window, &pixel_w, &pixel_h) || pixel_w <= 0 ||
+		pixel_h <= 0) {
+
+		return 0;
+	}
+	subset = Aeron_PresentationAvailableBox(pixel_w, pixel_h, &origin_x, &origin_y, &avail_width, &avail_height);
+	if (width) {
+		*width = avail_width;
+	}
+	if (height) {
+		*height = avail_height;
+	}
+
+	return subset ? 2 : 1;
