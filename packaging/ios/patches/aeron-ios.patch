+static void Aeron_ScaledPresentationInsets(int container_width, int container_height, int* left, int* top,
+										   int* right, int* bottom) {
+	*left   = g_aeron.presentation_inset_left;
+	*top    = g_aeron.presentation_inset_top;
+	*right  = g_aeron.presentation_inset_right;
+	*bottom = g_aeron.presentation_inset_bottom;
+	if (g_aeron.presentation_inset_ref_width <= 0 || g_aeron.presentation_inset_ref_height <= 0 ||
+		container_width <= 0 || container_height <= 0) {
