+		if (ctx->scroll_drag_moved) {
+			ctx->active_id           = ui_scroll_capture(id);
+			ctx->scroll_drag_capture = ctx->active_id;
+		}
+		ctx->scroll_drag_id    = 0;
+		ctx->scroll_drag_moved = 0;
