+# CMake de-duplicates a repeated bare -framework option and drops every
+# framework after the first. FFmpeg emits that form from pkg-config.
+function(aeron_preserve_framework_options target)
+    if(NOT TARGET "${target}")
+        return()
+    endif()
+    get_target_property(options "${target}" INTERFACE_LINK_OPTIONS)
+    if(NOT options)
+        return()
+    endif()
+    set(rewritten "")
+    list(LENGTH options count)
+    set(index 0)
+    while(index LESS count)
+        list(GET options ${index} item)
+        if(item STREQUAL "-framework")
+            math(EXPR next "${index} + 1")
+            if(next GREATER_EQUAL count)
+                break()
+            endif()
+            list(GET options ${next} framework)
+            list(APPEND rewritten "SHELL:-Wl,-framework,${framework}")
+            math(EXPR index "${index} + 2")
+        else()
+            list(APPEND rewritten "${item}")
+            math(EXPR index "${index} + 1")
+        endif()
+    endwhile()
+    set_property(TARGET "${target}" PROPERTY INTERFACE_LINK_OPTIONS "${rewritten}")
+endfunction()
