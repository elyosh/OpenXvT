+		return;
+	}
+	*left   = (int)(((int64_t)*left * container_width) / g_aeron.presentation_inset_ref_width);
+	*right  = (int)(((int64_t)*right * container_width) / g_aeron.presentation_inset_ref_width);
+	*top    = (int)(((int64_t)*top * container_height) / g_aeron.presentation_inset_ref_height);
+	*bottom = (int)(((int64_t)*bottom * container_height) / g_aeron.presentation_inset_ref_height);
